# ==============================================================================
# Mike OSS — Production Environment Configuration Template (.env.production.example)
#
# Copy this file to `.env.production` (or `.env` on your production host)
# and replace the placeholders with your production values and strong secrets.
# NEVER commit your actual .env or .env.production file to version control.
# ==============================================================================

# --- Application Topology & URLs ---
NODE_ENV=production
FRONTEND_PORT=3000
BACKEND_PORT=3001
GATEWAY_PORT=54321

# Public URL of the frontend (e.g., https://mike.yourdomain.com).
FRONTEND_URL=https://mike.yourdomain.com

# Browser-reachable frontend gateway used for OAuth callbacks, including MCP connectors.
# In production this must be HTTPS and include the `/api` prefix.
API_PUBLIC_URL=https://mike.yourdomain.com/api

# Browser-reachable Supabase gateway URL.
SUPABASE_PUBLIC_URL=https://mike.yourdomain.com:54321

# --- Cryptographic Secrets (REQUIRED) ---
# Generate separate 32-byte hex strings using: openssl rand -hex 32
DOWNLOAD_SIGNING_SECRET=generate-random-32-byte-hex-string
USER_API_KEYS_ENCRYPTION_SECRET=generate-random-32-byte-hex-string

# --- Supabase Database & JWT Secrets ---
# Strong password for the PostgreSQL postgres user
POSTGRES_PASSWORD=generate-strong-random-db-password

# High-entropy JWT secret (minimum 32 characters) used to sign Supabase tokens.
SUPABASE_JWT_SECRET=generate-super-secret-jwt-token-with-at-least-32-chars

# Generated JWTs matching SUPABASE_JWT_SECRET for anon and service_role.
# (If using managed Supabase or custom keys, paste them here.)
SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# --- S3 / RustFS Object Storage ---
# S3 credentials for document and asset storage
STORAGE_ACCESS_KEY=generate-strong-storage-access-key
STORAGE_SECRET_KEY=generate-strong-storage-secret-key
R2_BUCKET_NAME=mike

# If direct browser uploads are enabled, set the public URL of the storage endpoint
# R2_PUBLIC_ENDPOINT_URL=https://storage.yourdomain.com

# --- Production Email & SMTP (Supabase Auth) ---
# Configure real SMTP credentials for password resets and verification emails
GOTRUE_MAILER_AUTOCONFIRM=false
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-password-or-api-key
SMTP_ADMIN_EMAIL=noreply@yourdomain.com
SMTP_SENDER_NAME=Mike

# Optional: Google OAuth Configuration
GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=

# --- AI Model Providers ---
# Supply at least one API key, or users can provide their own in Settings
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional CourtListener Token for case law citations
COURTLISTENER_API_TOKEN=
