{
    "name": "mike",
    "private": true,
    "scripts": {
        "dev": "node scripts/dev.js",
        "prod": "docker compose -f docker-compose.prod.yml up --build -d && node scripts/check-prod.js",
        "prod:down": "docker compose -f docker-compose.prod.yml down",
        "prod:check": "node scripts/check-prod.js",
        "setup": "node scripts/init-env.js",
        "test:e2e": "playwright test",
        "test:e2e:local": "bash scripts/e2e-local-stack.sh",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:ui": "playwright test --ui"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@playwright/test": "^1.63.0",
        "@types/node": "^26.5.1",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=22"
    },
    "license": "AGPL-3.0-only",
    "allowScripts": {
        "fsevents@2.3.2": true
    }
}
